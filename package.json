{
  "name": "variation-bar-card",
  "version": "0.1.0",
  "description": "Home Assistant Lovelace card: a vertical bar centred on zero, orange above and blue below. Ideal for a rate of change.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run typecheck && vite build",
    "watch": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && prettier --check src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkuik/variation-bar-card.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs"
  ]
}
